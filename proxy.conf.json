{
  "/api/recommender/health": {
    "target": "http://localhost:8000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/recommender/health": "/health"
    },
    "logLevel": "debug"
  },
  "/api/recommender": {
    "target": "http://localhost:8000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/recommender": "/api/v1"
    },
    "logLevel": "debug"
  },
  "/api": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug"
  },
  "/ws": {
    "target": "http://localhost:8080",
    "secure": false,
    "ws": true,
    "changeOrigin": true,
    "logLevel": "debug"
  },
  "/media": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true
  }
}
